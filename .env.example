# Copia este archivo a .env y ajusta los valores.

# Postgres (Neon, Railway, Supabase o local). Si se deja vacío, se usa PGlite embebido en .data/pgdata
DATABASE_URL=

PORT=4000
# Cámbialo en producción: firma los tokens de sesión y los códigos de cupón
JWT_SECRET=cambia-este-secreto
# Orígenes permitidos (separados por coma). Vacío = cualquiera (solo desarrollo)
CORS_ORIGINS=
# Clave que Jarvis Paseo envía en la cabecera x-api-key
JARVIS_API_KEY=jarvis-dev-key

# En desarrollo el código OTP/2FA se devuelve en la respuesta porque no hay proveedor de SMS.
# Ponlo en false cuando conectes un proveedor real.
OTP_EN_RESPUESTA=true
# true = exigir coordenadas GPS dentro del radio del Paseo para monedas AR, Drops y «Llegué»
GEOCERCA_ESTRICTA=false
PARQUEO_TARIFA_HORA_BS=6

# Opcional: IA generativa (Claude). Sin clave, el sistema usa plantillas deterministas.
ANTHROPIC_API_KEY=
LLM_MODELO_SQL=claude-sonnet-5-5
LLM_MODELO_TEXTOS=claude-haiku-4-5-20251001

# Generador sintético
SEED_CLIENTES=2000
RECINTO_LAT=-16.5378
RECINTO_LNG=-68.0786

# Jarvis por voz: modelo local en Ollama (sin costo ni nube). Sin Ollama, Jarvis usa plantillas.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:1.5b
# Si el modelo tarda más que esto, se usa el borrador
JARVIS_TIMEOUT_MS=4000
# Segundos mínimos entre mensajes proactivos al mismo cliente
JARVIS_INTERVALO_S=45
# Metros caminando que entran en el «contexto cercano»
JARVIS_RADIO_M=60
# true = permitir Claude en la nube como segundo motor (requiere ANTHROPIC_API_KEY)
JARVIS_PERMITIR_NUBE=false
